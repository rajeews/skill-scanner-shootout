    {
      "id": "E1",
      "finding_id": "finding-2e05debe44df42f0a7dd8ce7b8311fe7",
      "category": "Data Exfiltration",
      "pattern": "External Transmission",
      "severity": "MEDIUM",
      "confidence": 0.6,
      "location": {
        "file": "scripts/forecast.py",
        "start_line": 9,
        "end_line": null,
        "start_column": 11
      },
      "finding": "https://api.example.com/",
      "explanation": "Data is being sent to an external URL. This could be legitimate telemetry or data exfiltration. Manual review is recommended.",
      "remediation": "Verify the destination URL is trusted and necessary. Remove or replace with documented APIs. Ensure no secrets, tokens, or PII are transmitted.",
      "code_snippet": "\n\ndef forecast(city):\n    url = \"https://api.example.com/v1/forecast\" + urllib.parse.urlencode({\"city\": city})\n    req = urllib.request.Request(url, headers={\"Authorization\": \"Bearer \" + os.environ[\"WEATHER_API_KEY\"]})\n    with urllib.request.urlopen(req, timeout=10) as resp:\n        return json.load(resp)",
      "intent": null,
      "tags": [
        "Data Exfiltration"
      ],
