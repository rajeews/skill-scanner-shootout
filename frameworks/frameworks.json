{
  "_note": "Mapping of rule families to framework items is the author's judgement, not an official crosswalk by any framework owner. Item IDs and titles were verified at the owners' pages on 2026-10-20.",
  "frameworks": {
    "owasp-llm-2025": {
      "name": "OWASP Top 10 for LLM Applications 2025",
      "root": "https://genai.owasp.org/llm-top-10/",
      "items": {
        "LLM01": "Prompt Injection",
        "LLM02": "Sensitive Information Disclosure",
        "LLM03": "Supply Chain",
        "LLM06": "Excessive Agency"
      }
    },
    "owasp-agentic-2026": {
      "name": "OWASP Top 10 for Agentic Applications for 2026 (published 2025-12-09)",
      "root": "https://genai.owasp.org/2025/12/09/owasp-top-10-for-agentic-applications-the-benchmark-for-agentic-security-in-the-age-of-autonomous-ai/",
      "items": {
        "ASI01": "Agent Goal Hijack",
        "ASI02": "Tool Misuse",
        "ASI03": "Identity & Privilege Abuse",
        "ASI04": "Agentic Supply Chain Vulnerabilities",
        "ASI05": "Unexpected Code Execution"
      }
    },
    "mitre-atlas": {
      "name": "MITRE ATLAS (atlas-data v5.6.0)",
